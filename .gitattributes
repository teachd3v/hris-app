# Normalize all text files to LF in the repo
* text=auto eol=lf

# Explicitly declare text files
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.toml text eol=lf
*.css  text eol=lf
*.env.example text eol=lf

# Binary files — no conversion
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.svg  binary
*.pdf  binary
