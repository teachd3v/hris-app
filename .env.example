# Variabel untuk pengembangan lokal. Salin ke KEDUA berkas dengan isi yang sama:
#   .env.local  -> dibaca `npm run dev` (Next.js)
#   .dev.vars   -> dibaca `npm run preview` / `npm run deploy` (wrangler/OpenNext)
# Di produksi, isi sebagai secret Worker:  npx wrangler secret put AUTH_SECRET

# WAJIB — kunci penandatangan sesi login (string acak panjang, mis. `openssl rand -base64 32`)
AUTH_SECRET=ganti-dengan-string-acak-panjang

# WAJIB di belakang proxy/Cloudflare
AUTH_TRUST_HOST=true

# Opsional — password awal semua akun sebelum diganti pemiliknya (default: HR@2026!)
# DEFAULT_PASSWORD=

# Opsional — true = server menolak presensi di luar radius kantor (default mati selama masa uji coba)
# ATTENDANCE_ENFORCE_GEOFENCE=true
